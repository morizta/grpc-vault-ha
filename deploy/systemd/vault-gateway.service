[Unit]
Description=Microservice Vault - Gateway Service
After=network.target vault-crypto.service vault-tokenize.service
Requires=vault-crypto.service vault-tokenize.service

[Service]
Type=simple
User=vault
Group=vault
EnvironmentFile=/etc/microservice-vault/gateway.env
ExecStart=/opt/microservice-vault/bin/gateway
Restart=always
RestartSec=5
LimitNOFILE=65535

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
